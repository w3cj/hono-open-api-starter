{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@a": ["./src/alias/index.ts"],
      "@a/*": ["./src/alias/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
